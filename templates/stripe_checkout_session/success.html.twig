{% extends 'base.html.twig' %}

{% block title %}Paiement reussi{% endblock %}

{% block body %}
    <main class="mx-auto max-w-3xl px-4 py-12">
        <section class="rounded-xl border border-emerald-200 bg-emerald-50 p-6">
            <h1 class="text-2xl font-semibold text-emerald-900">Paiement confirme</h1>
            <p class="mt-3 text-emerald-800">
                Merci pour votre commande. Votre paiement Stripe a ete valide.
            </p>
            <div class="mt-6">
                <a
                    href="{{ path('app_cart_index') }}"
                    class="inline-flex items-center rounded-md bg-emerald-700 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-800"
                >
                    Retour au panier
                </a>
            </div>
        </section>
    </main>
{% endblock %}
