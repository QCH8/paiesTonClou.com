{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
<div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto">
        <div class="text-center mb-5">
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">
                Inscription
            </h1>
            <p class="mt-2 text-sm text-gray-600">
                Créez vos identifiants
            </p>
        </div>

        <div class="rounded border border-slate-200 bg-white p-10 shadow">
            {% for flash_error in app.flashes('verify_email_error') %}
                <div class="mb-4 rounded-lg border border-red-200 bg-red-50 p-3 text-red-800">{{ flash_error }}</div>
            {% endfor %}

            {{ form_start(registrationForm) }}
                {{ form_errors(registrationForm) }}
                <div class="space-y-4">
                    <div>
                        {{ form_label(registrationForm.email, null, {
                            label_attr: { class: 'mb-1 block text-sm font-medium text-slate-700' }
                        }) }}
                        {{ form_widget(registrationForm.email) }}
                        {{ form_errors(registrationForm.email) }}
                    </div>
                    <div>
                        {{ form_label(registrationForm.plainPassword, 'Mot de passe', {
                            label_attr: { class: 'mb-1 block text-sm font-medium text-slate-700' }
                        }) }}
                        {{ form_widget(registrationForm.plainPassword) }}
                        {{ form_errors(registrationForm.plainPassword) }}
                    </div>
                    <div class="flex items-center gap-2">
                        {{ form_widget(registrationForm.agreeTerms) }}
                        {{ form_label(registrationForm.agreeTerms, null, {
                            label_attr: { class: 'text-sm text-slate-700' }
                        }) }}
                        {{ form_errors(registrationForm.agreeTerms) }}
                    </div>
                </div>

                <button type="submit" class="mt-6 rounded-full bg-sky-500 p-2 text-white shadow hover:bg-sky-700">
                    S'inscrire
                </button>
            {{ form_end(registrationForm) }}
            <div class="mt-4">
                <a href="{{ path('app_login') }}" class="rounded-full bg-slate-500 p-2 text-white shadow hover:bg-slate-700">
                    Déjà un compte ? Se connecter
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

