{% extends 'base.html.twig' %}

{% block title %}Catalogue produits{% endblock %}

{% block body %}
<section class="mx-auto w-full max-w-6xl px-4 py-8">
    <div class="mb-6">
        <h1 class="text-3xl font-bold tracking-tight">Catalogue produits</h1>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        {{ form_start(searchForm, { method: 'get' }) }}
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {{ form_widget(searchForm.q, { attr: { class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-2 focus:ring-slate-200' } }) }}
            {{ form_widget(searchForm.sku, { attr: { class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-2 focus:ring-slate-200' } }) }}
            {{ form_widget(searchForm.minPriceHT, { attr: { class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-2 focus:ring-slate-200' } }) }}
            {{ form_widget(searchForm.maxPriceHT, { attr: { class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-2 focus:ring-slate-200' } }) }}
            {{ form_widget(searchForm.category, { attr: { class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-2 focus:ring-slate-200' } }) }}
            <label class="inline-flex items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700">
                {{ form_widget(searchForm.activeOnly, { attr: { class: 'h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-300' } }) }}
                <span>Produits actifs uniquement</span>
            </label>
        </div>
        <div class="mt-4">
            <button type="submit" class="inline-flex items-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-slate-700">
                Rechercher
            </button>
        </div>
        {{ form_end(searchForm) }}
    </div>

    <p class="mt-5 text-sm text-slate-600">{{ pagination.total_items }} resultats.</p>

    {% if products is empty %}
        <div class="mt-4 rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-600">
            Aucun produit trouve.
        </div>
    {% else %}
        <div class="mt-4 grid gap-4 sm:grid-cols-3 xl:grid-cols-4">
            {% for product in products %}
                <article class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                    <h2 class="text-lg font-semibold text-slate-900">{{ product.name }}</h2>
                    <p class="mt-2 flex-1 text-sm text-slate-600">{{ product.description ?: 'Aucune description' }}</p>
                    <p class="mt-3 text-xs uppercase tracking-wide text-slate-500">Marque: {{ product.brandName ?: 'N/A' }}</p>
                    <a href="{{ path('shop_products_show', { slug: product.slug }) }}" class="mt-4 inline-flex w-fit items-center rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 transition hover:border-slate-400 hover:text-slate-900">
                        Voir le produit
                    </a>
                </article>
            {% endfor %}
        </div>
    {% endif %}

    {% if pagination.total_pages > 1 %}
        <nav aria-label="Pagination" class="mt-6">
            {% set current = pagination.page %}
            {% set qp = app.request.query.all %}
            <ul class="flex items-center gap-2">
                {% if current > 1 %}
                    <li>
                        <a href="{{ path('shop_products_index', qp|merge({ page: current - 1 })) }}" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 transition hover:border-slate-400 hover:text-slate-900">
                            Precedent
                        </a>
                    </li>
                {% endif %}

                <li class="text-sm text-slate-600">Page {{ current }} / {{ pagination.total_pages }}</li>

                {% if current < pagination.total_pages %}
                    <li>
                        <a href="{{ path('shop_products_index', qp|merge({ page: current + 1 })) }}" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 transition hover:border-slate-400 hover:text-slate-900">
                            Suivant
                        </a>
                    </li>
                {% endif %}
            </ul>
        </nav>
    {% endif %}
</section>
{% endblock %}
