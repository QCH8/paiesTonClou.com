{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
<section class="mx-auto w-full max-w-6xl px-4 py-8">
    <p>
        <a href="{{ path('shop_products_index') }}" class="inline-flex items-center gap-2 text-sm text-slate-600 transition hover:text-slate-900">
            <span aria-hidden="true">&larr;</span>
            Retour au catalogue
        </a>
    </p>

    <article class="mt-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h1 class="text-3xl font-bold tracking-tight text-slate-900">{{ product.name }}</h1>
        <p class="mt-3 text-slate-600">{{ product.description ?: 'Aucune description' }}</p>

        <div class="mt-4 grid gap-2 text-sm text-slate-700 sm:grid-cols-2">
            <p><span class="font-medium">Marque:</span> {{ product.brandName ?: 'N/A' }}</p>
            <p><span class="font-medium">Categorie:</span> {{ product.category ? product.category.name : 'Non classe' }}</p>
        </div>
    </article>

    <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold text-slate-900">Variantes</h2>

        {% if product.productVariants is empty %}
            <p class="mt-3 text-slate-600">Aucune variante.</p>
        {% else %}
            <div class="mt-4 overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200 text-sm">
                    <thead class="bg-slate-50">
                        <tr>
                            <th class="px-3 py-2 text-left font-semibold text-slate-700">SKU</th>
                            <th class="px-3 py-2 text-left font-semibold text-slate-700">Nom</th>
                            <th class="px-3 py-2 text-left font-semibold text-slate-700">Prix HT</th>
                            <th class="px-3 py-2 text-left font-semibold text-slate-700">TVA</th>
                            <th class="px-3 py-2 text-left font-semibold text-slate-700">Actif</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for v in product.productVariants %}
                            <tr>
                                <td class="px-3 py-2 font-mono text-xs text-slate-700">{{ v.stockKeepingUnit }}</td>
                                <td class="px-3 py-2 text-slate-700">{{ v.name }}</td>
                                <td class="px-3 py-2 text-slate-700">{{ (v.priceHT / 100)|number_format(2, ',', ' ') }} EUR</td>
                                <td class="px-3 py-2 text-slate-700">{{ (v.vatRate * 100)|number_format(0, ',', ' ') }} %</td>
                                <td class="px-3 py-2">
                                    {% if v.active %}
                                        <span class="rounded-full bg-emerald-100 px-2 py-1 text-xs font-medium text-emerald-700">Oui</span>
                                    {% else %}
                                        <span class="rounded-full bg-slate-100 px-2 py-1 text-xs font-medium text-slate-600">Non</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
</section>
{% endblock %}