{% extends 'base.html.twig' %}

{% block title %}Mon panier{% endblock %}

{% block body %}
<section class="mx-auto w-full max-w-6xl px-4 py-8">
    <h1 class="text-3xl font-bold tracking-tight">Mon panier</h1>

    {% if cart.cartItem is empty %}
        <div class="mt-6 rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-600">
            Votre panier est vide.
        </div>
    {% else %}
        <div class="mt-6 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
            <table class="min-w-full divide-y divide-slate-200 text-sm">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-3 py-2 text-left font-semibold text-slate-700">Produit</th>
                        <th class="px-3 py-2 text-left font-semibold text-slate-700">Prix HT</th>
                        <th class="px-3 py-2 text-left font-semibold text-slate-700">Quantite</th>
                        <th class="px-3 py-2 text-left font-semibold text-slate-700">Sous-total TTC</th>
                        <th class="px-3 py-2 text-left font-semibold text-slate-700">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for item in cart.cartItem %}
                        {% set lineHt = item.quantity * item.unitPriceHTSnapshot %}
                        {% set lineTtc = (lineHt * (1 + item.vatRateSnapshot))|round(0, 'common') %}
                        <tr>
                            <td class="px-3 py-2 text-slate-700">
                                <div class="font-medium">{{ item.productVariant.name }}</div>
                                <div class="text-xs text-slate-500">{{ item.productVariant.stockKeepingUnit }}</div>
                            </td>
                            <td class="px-3 py-2 text-slate-700">{{ (item.unitPriceHTSnapshot / 100)|number_format(2, ',', ' ') }} EUR</td>
                            <td class="px-3 py-2 text-slate-700">
                                <form method="post" action="{{ path('app_cart_item_update', { id: item.id }) }}" class="flex items-center gap-2">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cart_item_update_' ~ item.id) }}">
                                    <input
                                        type="number"
                                        min="1"
                                        name="quantity"
                                        value="{{ item.quantity }}"
                                        class="w-20 rounded-lg border border-slate-300 px-2 py-1 text-sm"
                                    >
                                    <button type="submit" class="rounded-lg border border-slate-300 px-2 py-1 text-xs hover:bg-slate-50">
                                        Mettre a jour
                                    </button>
                                </form>
                            </td>
                            <td class="px-3 py-2 text-slate-700">{{ (lineTtc / 100)|number_format(2, ',', ' ') }} EUR</td>
                            <td class="px-3 py-2">
                                <form method="post" action="{{ path('app_cart_item_remove', { id: item.id }) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cart_item_remove_' ~ item.id) }}">
                                    <button type="submit" class="rounded-lg bg-red-600 px-2 py-1 text-xs font-semibold text-white hover:bg-red-700">
                                        Retirer
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:max-w-sm">
            <dl class="space-y-2 text-sm">
                <div class="flex items-center justify-between">
                    <dt class="text-slate-600">Total HT</dt>
                    <dd class="font-medium text-slate-900">{{ (total_ht_cents / 100)|number_format(2, ',', ' ') }} EUR</dd>
                </div>
                <div class="flex items-center justify-between">
                    <dt class="text-slate-600">TVA</dt>
                    <dd class="font-small text-slate-900">{{ ((total_ttc_cents - total_ht_cents ) / 100)|number_format(2, ',', ' ') }} EUR</dd>
                </div>
                <div class="flex items-center justify-between">
                    <dt class="text-slate-600">Total TTC</dt>
                    <dd class="text-lg font-semibold text-slate-900">{{ (total_ttc_cents / 100)|number_format(2, ',', ' ') }} EUR</dd>
                </div>
            </dl>
        </div>
    {% endif %}
</section>
{% endblock %}

